{
  "manifest_version": 3,
  "name": "FocusTrack Redirector",
  "version": "1.0.0",
  "description": "Automatically redirect selected sites/social media to FocusTrack during work hours, and log every redirect that happens.",

  "permissions": ["storage", "webNavigation", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusTrack Redirector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}